{
  "name": "@smista-ai/sdk",
  "version": "0.0.0",
  "description": "TypeScript/JavaScript SDK for interacting with the smista-router HTTP API.",
  "license": "MIT",
  "author": "Christian Visintin <christian.visintin@veeso.dev>",
  "repository": {
    "type": "git",
    "url": "https://github.com/veeso/smista.ai.git",
    "directory": "sdk"
  },
  "homepage": "https://smista.ai",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome ci .",
    "test": "vitest run",
    "test:watch": "vitest",
    "release": "npm publish",
    "release:pre": "npm publish --tag next",
    "prepublishOnly": "npm run check && npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "typescript": "6.0.3",
    "vitest": "4.1.7"
  }
}
